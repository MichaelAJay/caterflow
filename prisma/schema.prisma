// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// MODELS (A-Z)
model CateringCompany {
  id                       String                               @id @default(uuid())
  name                     String
  isActive                 Boolean                              @default(false) @map("is_active")
  ownerId                  String                               @unique @map("owner_id")
  createdAt                DateTime                             @default(now()) @map("created_at")
  updatedAt                DateTime                             @updatedAt @map("updated_at")
  users                    User[]                               @relation("company_users")
  owner                    User                                 @relation("owner", fields: [ownerId], references: [id])
  caterers                 CompanyCaterer[]
  externalSystemConnection CompanyExternalSystemConnection[]
  integrations             CompanyIntegration[]
  integrationAssets        CompanyIntegrationRequirementAsset[]
  issues                   CompanyIssue[]
  menus                    CompanyMenu[]
  stores                   CompanyStore[]
  roles                    Role[]
  userCompanyRoles         UserCompanyRole[]
  userSystemActions        UserSystemAction[]

  @@map("catering_companies")
}

model CompanyCaterer {
  id          String  @id @default(uuid())
  name        String
  companyId   String  @map("company_id")
  ezCaterId   String?
  storeNumber String?

  company CateringCompany @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@map("company_caterers")
}

model CompanyExternalSystemConnection {
  id             String             @id @default(uuid())
  companyId      String             @map("company_id")
  systemName     ExternalSystemName @map("system_name")
  systemUIName   String             @map("system_ui_name")
  inboundStatus  ConnectionStatus   @default(UNCONFIGURED) @map("inbound_status")
  outboundStatus ConnectionStatus   @default(UNCONFIGURED) @map("outbound_status")
  assets         Json?              @default("{}")

  company        CateringCompany      @relation(fields: [companyId], references: [id])
  externalSystem ExternalSystem       @relation(fields: [systemName], references: [name])
  srcFor         CompanyIntegration[] @relation("SrcCompanyConnection")
  targetFor      CompanyIntegration[] @relation("TargetCompanyConnection")

  @@unique([companyId, systemName])
  @@index([companyId])
  @@map("company_external_system_connections")
}

model CompanyIntegration {
  id                 String            @id @default(uuid())
  companyId          String            @map("company_id")
  templateId         Int               @map("template_id")
  uiName             String            @map("ui_name")
  status             IntegrationStatus @default(NON_ACTIVATABLE)
  srcConnectionId    String            @map("src_connection_id")
  targetConnectionId String            @map("target_connection_id")
  event              IntegrationEvent
  creatorId          String            @map("creator_id")
  createdAt          DateTime          @default(now()) @map("created_at")

  company          CateringCompany                      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  template         IntegrationTemplate                  @relation(fields: [templateId], references: [id])
  assets           CompanyIntegrationRequirementAsset[]
  creator          User                                 @relation(fields: [creatorId], references: [id])
  srcConnection    CompanyExternalSystemConnection      @relation("SrcCompanyConnection", fields: [srcConnectionId], references: [id])
  targetConnection CompanyExternalSystemConnection      @relation("TargetCompanyConnection", fields: [targetConnectionId], references: [id])

  @@unique([companyId, templateId], name: "company_integration_unique", map: "company_integration_unique")
  @@index([companyId])
  @@map("company_integrations")
}

model CompanyIntegrationRequirementAsset {
  id            String  @id @default(uuid())
  companyId     String  @map("company_id")
  requirementId Int     @map("requirement_id")
  menuId        Int?    @map("menu_id")
  hasData       Boolean @default(false) @map("has_data")
  isSecret      Boolean @map("is_secret")
  data          Json?
  isTested      Boolean @default(false) @map("is_tested")
  creatorId     String  @map("creator_id")
  uiName        String
  uiDescription String

  company     CateringCompany        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  menu        CompanyMenu?           @relation(fields: [menuId], references: [id], onDelete: Cascade)
  requirement IntegrationRequirement @relation(fields: [requirementId], references: [id])

  integrations CompanyIntegration[]
  creator      User                 @relation("creator", fields: [creatorId], references: [id])

  @@unique([requirementId, menuId])
  @@index([companyId])
  @@map("company_integration_requirement_assets")
}

model CompanyIssue {
  id         String    @id @default(uuid())
  companyId  String    @map("company_id")
  message    String
  timestamp  DateTime  @default(now())
  resolved   Boolean   @default(false)
  resolvedAt DateTime?

  company CateringCompany @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@map("company_issues")
}

model CompanyMenu {
  id            Int     @id @default(autoincrement())
  companyId     String  @map("company_id")
  ezCaterMenuId String? @map("ezcater_menu_id")

  company CateringCompany                      @relation(fields: [companyId], references: [id])
  assets  CompanyIntegrationRequirementAsset[]

  @@index([companyId])
  @@map("company_menus")
}

model CompanyStore {
  id        String @id @default(uuid())
  companyId String @map("company_id")
  name      String

  company CateringCompany @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@map("company_stores")
}

model ExternalSystem {
  name          ExternalSystemName @id
  uiName        String             @map("ui_name")
  uiDescription String             @map("ui_description")
  requirements  Json               @default("{}")

  companyConnections CompanyExternalSystemConnection[]
  srcFor             IntegrationTemplate[]             @relation("SourceSystemRelation")
  targetFor          IntegrationTemplate[]             @relation("TargetSystemRelation")

  @@unique([name])
  @@map("external_systems")
}

model IntegrationRequirement {
  id            Int                         @id @default(autoincrement())
  type          IntegrationRequirementType
  name          IntegrationRequirementName
  level         IntegrationRequirementLevel
  uiName        String                      @map("ui_name")
  uiDescription String                      @map("ui_description")
  isSecret      Boolean

  requiredFor   IntegrationTemplate[]
  companyAssets CompanyIntegrationRequirementAsset[]

  @@unique([name])
  @@map("integration_requirements")
}

model IntegrationTemplate {
  id               Int                @id @default(autoincrement())
  uiName           String
  uiDescription    String
  event            IntegrationEvent
  srcSystemName    ExternalSystemName @map("src_system_name")
  srcEntity        ExternalEntity     @map("src_entity")
  targetSystemName ExternalSystemName @map("target_system_name")
  targetEntity     ExternalEntity     @map("target_entity")

  srcSystem    ExternalSystem           @relation("SourceSystemRelation", fields: [srcSystemName], references: [name])
  targetSystem ExternalSystem           @relation("TargetSystemRelation", fields: [targetSystemName], references: [name])
  requirements IntegrationRequirement[]
  integrations CompanyIntegration[]

  @@unique([event, targetSystemName, targetEntity])
  @@map("integration_templates")
}

model Permission {
  id   Int            @id @default(autoincrement())
  name PermissionName @unique

  roles Role[] @relation(name: "role_permissions")

  @@map("permissions")
}

model Role {
  id          String  @id @default(uuid())
  name        String
  description String  @default("")
  companyId   String? @map("company_id") // NULL companyId records indicate SYSTEM ROLES
  creatorId   String  @map("creator_id")
  isEditable  Boolean @default(true) @map("is_editable") // SYSTEM ROLES and their derivatives must have FALSE

  permissions      Permission[]      @relation(name: "role_permissions")
  company          CateringCompany?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userCompanyRoles UserCompanyRole[]
  creator          User              @relation(fields: [creatorId], references: [id])

  @@index([companyId])
  @@map("roles")
}

model User {
  id             String   @id @default(uuid())
  extAuthUID     String   @unique @map("ext_auth_uid")
  companyId      String?  @map("company_id")
  emailEncrypted String   @map("email_encrypted")
  emailHashed    String   @unique @map("email_hashed")
  nameEncrypted  String   @map("name_encrypted")
  emailVerified  Boolean  @default(false) @map("email_verified")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  company                  CateringCompany?                     @relation(name: "company_users", fields: [companyId], references: [id], onDelete: Cascade)
  ownerOf                  CateringCompany?                     @relation("owner")
  userCompanyRoles         UserCompanyRole[]                    @relation("user")
  createdUserCompanyRoles  UserCompanyRole[]                    @relation("creator")
  createdRoles             Role[]
  createdIntegrations      CompanyIntegration[]
  createdIntegrationAssets CompanyIntegrationRequirementAsset[] @relation("creator")
  systemActions            UserSystemAction[]

  @@index([extAuthUID])
  @@index([companyId])
  @@map("users")
}

model UserCompanyRole {
  roleId    String @map("role_id")
  userId    String @map("user_id")
  companyId String @map("company_id")
  creatorId String @map("creator_id")

  role    Role            @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user    User            @relation("user", fields: [userId], references: [id], onDelete: Cascade)
  company CateringCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  addedBy User            @relation("creator", fields: [creatorId], references: [id])

  @@id([roleId, userId])
  @@index([userId])
  @@index([companyId])
  @@map("user_company_roles")
}

model UserSystemAction {
  id        String             @id @default(uuid())
  userId    String             @map("user_id")
  companyId String?            @map("company_id")
  action    SystemAction
  result    SystemActionResult
  details   Json?
  date      DateTime           @default(now())

  user    User             @relation(fields: [userId], references: [id])
  company CateringCompany? @relation(fields: [companyId], references: [id])

  @@map("user_system_actions")
}

// ENUMS (A-Z)
enum ConnectionStatus {
  UNCONFIGURED
  CONFIGURED_UNTESTED
  TEST_FAILED
  READY
  NOT_APPLICABLE
}

enum ExternalEntity {
  Order
  Lead
}

enum ExternalSystemName {
  EZ_CATER
  NUTSHELL
  TEST_NO_INBOUND_NO_OUTBOUND
  TEST_NO_OUTBOUND
  TEST_NO_INBOUND
  TEST_NO_OUTBOUND_CONFIG
  TEST_NO_INBOUND_CONFIG
}

enum IntegrationEvent {
  ezCaterOrderReceived
}

enum IntegrationRequirementLevel {
  Company
  Menu
}

enum IntegrationRequirementName {
  EZ_CATER_ORDER_TO_NUTSHELL_LEAD_DM
}

enum IntegrationRequirementType {
  DATA_MAP
}

enum IntegrationStatus {
  NON_ACTIVATABLE
  ACTIVATABLE
  ACTIVE
  ERROR
}

enum PermissionName {
  ManageBilling
  ManageCompanyCaterers
  ManageCompanyRoles
  ManageIntegrations
  ManageIntegrationAssets
  ManageRoleAssignments
  ViewMessages
}

enum SystemAction {
  AddUser
  RemoveUser
  AddIntegration
  UpdateIntegration
  DeleteIntegration
  AddIntegrationAsset
  UpdateIntegrationAsset
  DeleteIntegrationAsset
  AddRole
  EditRole
  DeleteRole
  AssignRole
  UnassignRole
  UpdateBilling
}

enum SystemActionResult {
  SUCCESS
  ERROR
}
